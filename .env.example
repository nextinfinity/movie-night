# Commas or whitespace separate Letterboxd usernames. Empty means no defaults.
DEFAULT_USERS=
# Local testing: loopback. On your server, use its LAN IP (e.g. 192.168.1.20).
BIND_ADDRESS=127.0.0.1
PORT=8000
# Published image for compose.yaml; replace with the real lowercase owner/repo.
MOVIE_NIGHT_IMAGE=ghcr.io/your-github-owner/movie-night:latest
